# The tour API. Built from the repository root:
#     docker build -f examples/tour/deploy/Dockerfile.api -t acme-tour-api .
FROM python:3.12-slim

# pdftotext reads a .pdf 行程附件 (api/pdf_source.py); the rest is what pip needs to build
# the pinned wheels that have no manylinux build.
RUN apt-get update \
    && apt-get install -y --no-install-recommends poppler-utils curl build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1

# The seven packages install from the tree, so the tree comes first.
COPY requirements.txt ./
COPY commerce-common ./commerce-common
COPY shopping-agent ./shopping-agent
COPY merchant-agent ./merchant-agent
RUN pip install --no-cache-dir -r requirements.txt

COPY examples ./examples

# The advisor's conversations, their memory and the 线路文档 live here, on a volume that
# outlives the container.
ENV TOUR_STATE_DIR=/state
VOLUME ["/state"]
EXPOSE 8004

HEALTHCHECK --interval=30s --timeout=5s --start-period=40s \
    CMD curl -fsS http://127.0.0.1:8004/api/health || exit 1

CMD ["uvicorn", "tour.api.main:app", "--app-dir", "examples", "--host", "0.0.0.0", "--port", "8004"]
