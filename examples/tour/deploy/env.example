# Copy to examples/tour/deploy/.env on the server and fill in. Nothing here is committed:
# the file holds the deployment's own ERP account and its model key.

# The name the certificate is issued for and the workbench is opened at.
TOUR_PUBLIC_HOST=tour.example.com
# Where fullchain.pem and privkey.pem sit on the host.
TOUR_TLS_DIR=/etc/letsencrypt/live/tour.example.com
# The state directory on the host: sessions.sqlite, memory-store.json, route-docs/.
TOUR_STATE_PATH=/srv/acme-tour/state

# The model. An Anthropic-compatible endpoint; leave the base URL unset for Anthropic's own.
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_API_KEY=
TOUR_MODEL=deepseek-flash
TOUR_MEMORY_MODEL=deepseek-chat

# The agency's ERP, and the deployment's own account: it boots the catalog and resolves the
# 同行 customer. Every advisor signs in with their own mobile and password, which this
# process forwards once and never stores.
TOUR_ERP_BASE_URL=https://b2b-backend.example.com/aicli
TOUR_ERP_MOBILE=
TOUR_ERP_PASSWORD=
TOUR_ERP_CUSTOMER_CODE=

# INFO is a line per model call; DEBUG adds the bodies.
DEMO_LOG_LEVEL=INFO
