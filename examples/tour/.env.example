# Copy to examples/tour/.env (read by examples/demo_common/host.py after the environment
# and before the repo-root .env). Never put a real key in this file.
#
# The agent talks to whatever serves the Anthropic Messages API at ANTHROPIC_BASE_URL;
# the Anthropic SDK reads that variable and the key itself. TOUR_MODEL names the turn
# model and TOUR_MEMORY_MODEL the memory-extraction model in that provider's own ids;
# TOUR_MEMORY_MODEL falls back to TOUR_MODEL. Keep exactly one block uncommented.

# --- Anthropic (repo defaults: claude-sonnet-5 / claude-haiku-4-5) ---
ANTHROPIC_API_KEY=

# --- DeepSeek, Anthropic-compatible endpoint (https://api-docs.deepseek.com/guides/anthropic_api) ---
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# ANTHROPIC_API_KEY=
# TOUR_MODEL=deepseek-v4-flash
# TOUR_MEMORY_MODEL=deepseek-v4-flash

# --- Kimi (Moonshot), Anthropic-compatible endpoint (https://platform.kimi.com/docs) ---
# ANTHROPIC_BASE_URL=https://api.moonshot.cn/anthropic
# ANTHROPIC_API_KEY=
# TOUR_MODEL=kimi-k2.6
# TOUR_MEMORY_MODEL=kimi-k2.6

# --- The B2B 旅行社 ERP behind the advisor (optional) ---
# Unset, the example runs on the fixtures in data/. Set, api/main.py builds the HttpErpClient
# and logs in with the advisor's own ERP account; the reads then see what that salesperson
# sees. None of these ever reaches the model.
# TOUR_ERP_BASE_URL=      # the ERP's /aicli root, HTTPS in production
# TOUR_ERP_MOBILE=        # the advisor's ERP login, a mainland mobile number
# TOUR_ERP_PASSWORD=      # its password; ten failed logins lock the account for 15 minutes
# TOUR_ERP_COMPANY_ID=    # the department (companyId) to log in to; required in practice
# TOUR_ERP_CUSTOMER_ID=   # the 同行 customer every quote and order is made for
# TOUR_ERP_ALLOW_PAST=    # 1 lists departures that already left, for a beta with no future ones
