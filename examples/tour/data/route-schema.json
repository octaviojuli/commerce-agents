    "Money": {
      "additionalProperties": false,
      "properties": {
        "raw": {
          "default": "",
          "title": "Raw",
          "type": "string"
        },
        "source_lines": {
          "items": {
            "minimum": 1,
            "type": "integer"
          },
          "title": "Source Lines",
          "type": "array"
        },
        "amount": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amount"
        },
        "currency": {
          "default": "",
          "title": "Currency",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "enum": [
                "person",
                "room",
                "night"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "title": "Money",
      "type": "object"
    },
    "OptionalItem": {
      "additionalProperties": false,
      "description": "A 自费项目 with the price as written (``120 美金/人``).",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "price": {
          "default": "",
          "title": "Price",
          "type": "string"
