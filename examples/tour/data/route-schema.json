          "$ref": "#/$defs/Meal"
        },
        "lunch": {
          "$ref": "#/$defs/Meal"
        },
        "dinner": {
          "$ref": "#/$defs/Meal"
        }
      },
      "title": "Meals",
      "type": "object"
    },
    "Meeting": {
      "additionalProperties": false,
      "properties": {
        "raw": {
          "default": "",
          "title": "Raw",
          "type": "string"
        },
        "source_lines": {
          "items": {
            "minimum": 1,
            "type": "integer"
          },
          "title": "Source Lines",
          "type": "array"
        },
        "location": {
          "default": "",
          "title": "Location",
          "type": "string"
        },
        "time": {
          "default": "",
          "title": "Time",
          "type": "string"
        },
        "domestic_connection": {
          "default": "",
          "title": "Domestic Connection",
          "type": "string"
        }
      },
      "title": "Meeting",
      "type": "object"
