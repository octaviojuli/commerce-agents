    "Quality": {
      "additionalProperties": false,
      "description": "``completeness`` is the parser's own score in [0, 1] (``route_parser.score``);\n``needs_review`` names what a person should check, in the reviewer's language;\n``reviewed_by``/``reviewed_at`` are set by the reviewer, never by the parser.",
      "properties": {
        "completeness": {
          "maximum": 1,
          "minimum": 0,
          "title": "Completeness",
          "type": "number"
        },
        "needs_review": {
          "items": {
            "type": "string"
          },
          "title": "Needs Review",
          "type": "array"
        },
        "reviewed_by": {
          "default": "",
          "title": "Reviewed By",
          "type": "string"
        },
        "reviewed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed At"
        },
        "resolutions": {
          "items": {
            "$ref": "#/$defs/ReviewResolution"
          },
          "maxItems": 200,
          "title": "Resolutions",
          "type": "array"
        }
      },
      "required": [
        "completeness"
      ],
      "title": "Quality",
      "type": "object"
    },
    "ReviewResolution": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "basis_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Basis Hash",
          "type": "string"
        },
        "note": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "code",
        "path",
        "basis_hash",
        "note"
      ],
      "title": "ReviewResolution",
      "type": "object"
    },
