          "default": "",
          "title": "Raw",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "OptionalItem",
      "type": "object"
    },
    "PageLocation": {
      "additionalProperties": false,
      "description": "Physical PDF pages of a parsed source block, not proof of every derived field.\n\nDay numbering refers to the original parse. Human revisions do not move these\nlocators. DOCX and historical parses without location evidence leave them absent.",
      "properties": {
        "section": {
          "enum": [
            "cover",
            "itinerary",
            "terms"
          ],
          "title": "Section",
          "type": "string"
        },
        "day": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Day"
        },
        "pages": {
          "items": {
            "minimum": 1,
            "type": "integer"
          },
          "minItems": 1,
          "title": "Pages",
          "type": "array"
        }
      },
      "required": [
        "section",
        "pages"
      ],
      "title": "PageLocation",
      "type": "object"
    },
    "PassengerRule": {
      "additionalProperties": false,
