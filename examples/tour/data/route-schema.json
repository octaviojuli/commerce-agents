{
  "$defs": {
    "Applicability": {
      "additionalProperties": false,
      "properties": {
        "raw": {
          "default": "",
          "title": "Raw",
          "type": "string"
        },
        "source_lines": {
          "items": {
            "minimum": 1,
            "type": "integer"
          },
          "title": "Source Lines",
          "type": "array"
        },
        "start": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        },
        "end": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "departure_cities": {
          "items": {
            "type": "string"
          },
          "title": "Departure Cities",
          "type": "array"
        },
        "version_label": {
          "default": "",
          "title": "Version Label",
          "type": "string"
        }
      },
      "title": "Applicability",
      "type": "object"
    },
    "CancellationTier": {
      "additionalProperties": false,
      "properties": {
        "raw": {
          "default": "",
          "title": "Raw",
          "type": "string"
        },
        "source_lines": {
          "items": {
            "minimum": 1,
            "type": "integer"
          },
          "title": "Source Lines",
          "type": "array"
        },
        "days_before_min": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Days Before Min"
        },
        "days_before_max": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Days Before Max"
        },
        "penalty_percent": {
          "anyOf": [
            {
              "maximum": 100.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Penalty Percent"
        },
        "penalty_money": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "CancellationTier",
      "type": "object"
    },
    "Cover": {
      "additionalProperties": false,
      "description": "The attachment's front matter: the labelled rows (航空公司, 酒店标准, 用餐安排, 吃/住/行)\nand the ★ highlights, as written.",
      "properties": {
        "airline": {
          "default": "",
          "title": "Airline",
          "type": "string"
        },
        "hotel_standard": {
          "default": "",
          "title": "Hotel Standard",
          "type": "string"
        },
        "meal_standard": {
          "default": "",
          "title": "Meal Standard",
          "type": "string"
        },
        "highlights": {
          "items": {
            "type": "string"
          },
          "title": "Highlights",
          "type": "array"
        },
        "fields": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Fields",
          "type": "object"
        }
      },
      "title": "Cover",
      "type": "object"
    },
    "Day": {
      "additionalProperties": false,
      "description": "One itinerary day. ``places`` is the title's A-B-C route; ``distances_km`` the KM\nfigures written between them; ``transport`` the 车程/交通 notes; ``text`` the programme\nas written, kept whole because the parsed fields are a reading of it and not a\nreplacement.",
      "properties": {
        "day": {
          "title": "Day",
          "type": "integer"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "places": {
          "items": {
            "type": "string"
          },
          "title": "Places",
          "type": "array"
        },
        "distances_km": {
          "items": {
            "type": "integer"
          },
          "title": "Distances Km",
          "type": "array"
        },
        "transport": {
          "default": "",
          "title": "Transport",
          "type": "string"
        },
        "travel_reference": {
          "default": "",
          "maxLength": 4000,
          "title": "Travel Reference",
          "type": "string"
        },
        "countries": {
          "items": {
            "type": "string"
          },
          "title": "Countries",
          "type": "array"
        },
        "cities": {
          "items": {
            "type": "string"
          },
          "title": "Cities",
          "type": "array"
        },
        "location_raw": {
          "default": "",
          "title": "Location Raw",
          "type": "string"
        },
        "vehicle_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vehicle Type"
        },
        "vehicle_raw": {
          "default": "",
          "title": "Vehicle Raw",
          "type": "string"
        },
        "overnight": {
          "default": "unknown",
          "enum": [
            "hotel",
            "ship",
            "flight",
            "home",
            "unknown"
          ],
          "title": "Overnight",
          "type": "string"
        },
        "flights": {
          "items": {
            "$ref": "#/$defs/Flight"
          },
          "title": "Flights",
          "type": "array"
        },
        "sights": {
          "items": {
            "$ref": "#/$defs/Sight"
          },
          "title": "Sights",
          "type": "array"
        },
        "meals": {
          "$ref": "#/$defs/Meals"
        },
        "hotel": {
          "anyOf": [
            {
              "$ref": "#/$defs/Hotel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "text": {
          "default": "",
          "title": "Text",
          "type": "string"
        },
        "day_id": {
          "default": "",
          "maxLength": 80,
          "title": "Day Id",
          "type": "string"
        },
        "summary": {
          "default": "",
          "maxLength": 800,
          "title": "Summary",
          "type": "string"
        },
        "blocks": {
          "items": {
            "$ref": "#/$defs/ItineraryBlock"
          },
          "maxItems": 150,
          "title": "Blocks",
          "type": "array"
        },
        "summary_basis_hash": {
          "default": "",
          "title": "Summary Basis Hash",
          "type": "string"
        }
      },
      "required": [
        "day",
        "title"
      ],
      "title": "Day",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "raw": {
          "default": "",
          "title": "Raw",
          "type": "string"
        },
        "source_lines": {
          "items": {
            "minimum": 1,
            "type": "integer"
          },
          "title": "Source Lines",
          "type": "array"
        }
      },
      "title": "Evidence",
      "type": "object"
    },
    "Flight": {
      "additionalProperties": false,
      "description": "One flight segment as the attachment writes it (参考航班 MU6017 上海浦东-科伦坡 1425-1900).\nTimes are kept as written — an attachment states 夏令时/冬令时 pairs and ``+1`` days — and\n``day`` is the itinerary day the segment is on.",
      "properties": {
        "day": {
          "title": "Day",
          "type": "integer"
        },
        "flight_no": {
          "default": "",
          "title": "Flight No",
          "type": "string"
        },
        "carrier": {
          "default": "",
          "title": "Carrier",
          "type": "string"
        },
        "from_place": {
          "default": "",
          "title": "From Place",
          "type": "string"
        },
        "to_place": {
          "default": "",
          "title": "To Place",
          "type": "string"
        },
        "times": {
          "default": "",
          "title": "Times",
          "type": "string"
        },
        "raw": {
          "title": "Raw",
          "type": "string"
        },
        "departure_local_time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Departure Local Time"
        },
        "arrival_local_time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Arrival Local Time"
        },
        "arrival_day_offset": {
          "anyOf": [
            {
              "maximum": 3,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Arrival Day Offset"
        }
      },
      "required": [
        "day",
        "raw"
      ],
      "title": "Flight",
      "type": "object"
    },
    "Formation": {
      "additionalProperties": false,
      "properties": {
        "raw": {
          "default": "",
          "title": "Raw",
          "type": "string"
        },
        "source_lines": {
          "items": {
            "minimum": 1,
            "type": "integer"
          },
          "title": "Source Lines",
          "type": "array"
        },
        "minimum_travelers": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Travelers"
        },
        "failure_action": {
          "default": "",
          "title": "Failure Action",
          "type": "string"
        },
        "booking_deadline": {
          "default": "",
          "title": "Booking Deadline",
          "type": "string"
        }
      },
      "title": "Formation",
      "type": "object"
    },
    "Hotel": {
      "additionalProperties": false,
      "description": "The night's 住宿: the names as written (several alternatives joined by ``/``), whether\nthe attachment says 或同级, and the standard where a grade is stated on the line.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "or_similar": {
          "default": false,
          "title": "Or Similar",
          "type": "boolean"
        },
        "grade": {
          "default": "",
          "title": "Grade",
          "type": "string"
        },
        "grade_basis": {
          "default": "unknown",
          "enum": [
            "supplier_description",
            "official_rating",
            "unknown"
          ],
          "title": "Grade Basis",
          "type": "string"
        },
        "room_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Room Type"
        },
        "consecutive_nights": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Consecutive Nights"
        },
        "raw": {
          "default": "",
          "title": "Raw",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "Hotel",
      "type": "object"
    },
    "Insurance": {
      "additionalProperties": false,
      "properties": {
        "raw": {
          "default": "",
          "title": "Raw",
          "type": "string"
        },
        "source_lines": {
          "items": {
            "minimum": 1,
            "type": "integer"
          },
          "title": "Source Lines",
          "type": "array"
        },
        "included": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Included"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        }
      },
      "title": "Insurance",
      "type": "object"
    },
    "ItineraryBlock": {
      "additionalProperties": false,
      "description": "Ordered presentation content. Evidence remains in the immutable original parse.",
      "properties": {
        "block_id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Block Id",
          "type": "string"
        },
        "type": {
          "default": "programme",
          "enum": [
            "programme",
            "transport",
            "visit",
            "free_time",
            "shopping",
            "optional",
            "notice"
          ],
          "title": "Type",
          "type": "string"
        },
        "title": {
          "default": "",
          "maxLength": 200,
          "title": "Title",
          "type": "string"
        },
        "paragraphs": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Paragraphs",
          "type": "array"
        },
        "visit_mode": {
          "default": "unknown",
          "enum": [
            "inside",
            "outside",
            "passing",
            "unknown"
          ],
          "title": "Visit Mode",
          "type": "string"
        },
        "ticket_status": {
          "default": "unknown",
          "enum": [
            "included",
            "excluded",
            "unknown"
          ],
          "title": "Ticket Status",
          "type": "string"
        }
      },
      "required": [
        "block_id"
      ],
      "title": "ItineraryBlock",
      "type": "object"
    },
    "Meal": {
      "additionalProperties": false,
      "description": "An explicit meal statement; an empty cell remains unknown.",
      "properties": {
        "text": {
          "default": "",
