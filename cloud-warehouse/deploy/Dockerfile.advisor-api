# Reuse the tested Python dependencies and OCR tools of the warehouse API image.
ARG WAREHOUSE_API_IMAGE
FROM ${WAREHOUSE_API_IMAGE}
COPY examples/tour/advisor /app/examples/tour/advisor
ENV ADVISOR_HOST=0.0.0.0 ADVISOR_PORT=8006 ADVISOR_MATERIAL_DIR=/materials ADVISOR_SECURE_COOKIE=1
EXPOSE 8006
HEALTHCHECK --interval=15s --timeout=5s --start-period=60s \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8006/api/health',timeout=3)"
CMD ["python", "-m", "tour.advisor.serve"]
