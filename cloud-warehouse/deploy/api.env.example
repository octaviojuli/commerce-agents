# Raw env_file: literal values, no surrounding quotes, interpolation or inline comments.
# Percent-encode special characters in URL usernames/passwords.
WAREHOUSE_DATABASE_URL=postgresql+psycopg://warehouse_runtime:REPLACE_PASSWORD@database:5432/warehouse
WAREHOUSE_AUTH_URL=postgresql+psycopg://warehouse_auth:REPLACE_PASSWORD@database:5432/warehouse
# Optional operations-only metrics. Generate 32 random bytes as 64 lowercase hex characters.
# Leave absent to disable /metrics; never reuse a platform login or an ERP secret.
# WAREHOUSE_METRICS_TOKEN=REPLACE_WITH_RANDOM_64_HEX
SUPPLIER_A_BASE_URL=https://b2b.acme.example/api
SUPPLIER_A_MOBILE=REPLACE_LOGIN
SUPPLIER_A_PASSWORD=REPLACE_PASSWORD
# Optional chat configuration. Leave absent to keep chat disabled.
# ANTHROPIC_API_KEY=REPLACE_KEY
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# TOUR_MODEL=REPLACE_MODEL

# Optional uniform settlement policy. Configure both together, using the same
# version as supplier_connection.capabilities.settlement_pricing.version.
# Only the API needs this private upstream query identity. Never a buyer UI field.
# SUPPLIER_A_STANDARD_CUSTOMER_ID=REPLACE_APPROVED_NUMERIC_ID
# SUPPLIER_A_STANDARD_PRICE_VERSION=1
