# Compose interpolation only; no passwords in this file. Replace release tags with tested digests.
WAREHOUSE_API_IMAGE=local/warehouse-api:REPLACE_RELEASE
WAREHOUSE_ADVISOR_IMAGE=local/warehouse-advisor:REPLACE_RELEASE
WAREHOUSE_MERCHANT_IMAGE=local/warehouse-merchant:REPLACE_RELEASE
WAREHOUSE_POSTGRES_IMAGE=postgres:16-bookworm
WAREHOUSE_PROMETHEUS_IMAGE=prom/prometheus:v3.14.0
WAREHOUSE_CONFIG_DIR=/opt/tour-warehouse/config
WAREHOUSE_DATA_DIR=/opt/tour-warehouse/data
WAREHOUSE_ADVISOR_PORT=18085
WAREHOUSE_MERCHANT_PORT=18105
# Size this within the host CPU budget and verify with the isolated capacity probe.
WAREHOUSE_DATABASE_CPUS=1.0
# Copy these IDs from the restored source context, or the output of explicit onboarding.
WAREHOUSE_CONNECTION_ID=00000000-0000-0000-0000-000000000001
WAREHOUSE_SUPPLIER_ID=00000000-0000-0000-0000-000000000002
WAREHOUSE_WORKER_ID=00000000-0000-0000-0000-000000000003
