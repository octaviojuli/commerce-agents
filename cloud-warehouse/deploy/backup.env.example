# Private operator environment. Not an application env file; mode 0600.
# Replace the database URL and name with the same explicit target.
WAREHOUSE_ADMIN_URL=postgresql+psycopg://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST:5432/REPLACE_DATABASE
WAREHOUSE_BACKUP_DATABASE=REPLACE_DATABASE
WAREHOUSE_OBJECT_ROOT=/opt/tour-warehouse/data/objects
WAREHOUSE_BACKUP_ROOT=/var/lib/tour-warehouse-backups
# Preflight limits only, not filesystem quotas. Set to approved values before enabling.
WAREHOUSE_BACKUP_MAX_BYTES=REPLACE_MAX_BYTES
WAREHOUSE_BACKUP_RESERVE_BYTES=REPLACE_RESERVE_BYTES
# The admin Python environment must install the matching release and pg_dump tool.
