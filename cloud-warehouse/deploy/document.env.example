WAREHOUSE_DATABASE_URL=postgresql+psycopg://warehouse_runtime:REPLACE_PASSWORD@database:5432/warehouse
# Legacy parser configuration is retained only for upgrade comparison and rollback.
# Route-kit uses the explicitly authorized model for itinerary text and images.
# Never provide ERP, order or customer credentials to this worker.
TOUR_EXTRACTION_MODEL=
TOUR_CONTENT_MODEL=
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=

# Native file isolation, model-only extraction, private per-source cache.
ROUTE_KIT_ENABLED=false
ROUTE_KIT_MODEL=
ROUTE_KIT_CACHE=/route-kit-cache
