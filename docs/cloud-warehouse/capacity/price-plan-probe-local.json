  "candidate_sql": "CREATE OR REPLACE FUNCTION public.warehouse_applicable_prices(offer_uuid uuid,buyer_uuid uuid)\nRETURNS SETOF public.contract_price LANGUAGE plpgsql STABLE SECURITY INVOKER AS $$ BEGIN RETURN QUERY SELECT p.* FROM public.contract_price p\nWHERE p.offer_id=offer_uuid AND p.active\nAND (buyer_uuid=public.warehouse_org_id() OR p.supplier_org_id=public.warehouse_org_id())\nAND EXISTS(SELECT 1 FROM public.distribution_grant g WHERE g.connection_id=p.connection_id\nAND g.buyer_org_id=buyer_uuid AND public.warehouse_live_grant(g.id))\nAND ((p.layer='contract' AND p.buyer_org_id=buyer_uuid AND public.warehouse_live_grant(p.grant_id))\nOR p.layer='standard'\nOR (p.layer='grade' AND EXISTS(SELECT 1 FROM public.buyer_price_grade b WHERE b.connection_id=p.connection_id\nAND b.buyer_org_id=buyer_uuid AND b.grade_key=p.grade_key AND b.active AND public.warehouse_live_grant(b.grant_id)))); END $$",
