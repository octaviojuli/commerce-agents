        "sale_movement_id": {
          "format": "uuid",
          "title": "Sale Movement Id",
          "type": "string"
        },
        "additional_sold": {
          "const": 0,
          "default": 0,
          "title": "Additional Sold",
          "type": "integer"
        }
      },
      "required": [
        "order_id",
        "supplier_org_id",
        "pool_id",
        "sale_movement_id"
      ],
      "title": "ExistingSaleLink",
      "type": "object"
    },
    "SupplierWriteResult": {
      "$defs": {
        "ConfirmedResult": {
          "additionalProperties": false,
          "properties": {
            "outcome": {
              "const": "CONFIRMED",
              "default": "CONFIRMED",
              "title": "Outcome",
              "type": "string"
            },
            "reference": {
              "$ref": "#/$defs/ExternalReference"
            }
          },
          "required": [
            "reference"
          ],
          "title": "ConfirmedResult",
          "type": "object"
        },
        "ExternalReference": {
          "additionalProperties": false,
          "properties": {
            "connection_id": {
              "format": "uuid",
              "title": "Connection Id",
              "type": "string"
            },
            "department_key": {
              "anyOf": [
                {
                  "maxLength": 128,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Department Key"
            },
            "object_kind": {
              "enum": [
                "reservation",
                "order"
              ],
              "title": "Object Kind",
              "type": "string"
            },
