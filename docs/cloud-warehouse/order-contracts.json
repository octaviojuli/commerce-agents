              "title": "External Id",
              "type": "string"
            }
          },
          "required": [
            "connection_id",
            "department_key",
            "object_kind",
            "external_id"
          ],
          "title": "ExternalReference",
          "type": "object"
        },
        "HeldResult": {
          "additionalProperties": false,
          "properties": {
            "outcome": {
              "const": "HELD",
              "default": "HELD",
              "title": "Outcome",
              "type": "string"
            },
            "reference": {
              "$ref": "#/$defs/ExternalReference"
            },
            "held_until": {
              "format": "date-time",
              "title": "Held Until",
              "type": "string"
            }
          },
          "required": [
            "reference",
            "held_until"
          ],
          "title": "HeldResult",
          "type": "object"
        },
        "RejectedResult": {
          "additionalProperties": false,
          "properties": {
            "outcome": {
              "const": "REJECTED",
              "default": "REJECTED",
              "title": "Outcome",
              "type": "string"
            },
            "code": {
              "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
              "title": "Code",
              "type": "string"
            }
          },
          "required": [
            "code"
          ],
          "title": "RejectedResult",
          "type": "object"
        },
        "UnknownResult": {
          "additionalProperties": false,
          "properties": {
            "outcome": {
              "const": "UNKNOWN",
              "default": "UNKNOWN",
              "title": "Outcome",
              "type": "string"
            },
            "attempt_id": {
              "format": "uuid",
              "title": "Attempt Id",
              "type": "string"
            },
            "reference": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ExternalReference"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "next_action": {
              "const": "RECONCILE",
              "default": "RECONCILE",
              "title": "Next Action",
              "type": "string"
            }
          },
          "required": [
            "attempt_id"
          ],
          "title": "UnknownResult",
          "type": "object"
        },
        "WaitlistedResult": {
          "additionalProperties": false,
          "properties": {
            "outcome": {
              "const": "WAITLISTED",
              "default": "WAITLISTED",
              "title": "Outcome",
              "type": "string"
            },
            "reference": {
              "$ref": "#/$defs/ExternalReference"
            },
            "reservation_created": {
              "const": false,
              "default": false,
              "title": "Reservation Created",
              "type": "boolean"
            }
          },
          "required": [
            "reference"
          ],
          "title": "WaitlistedResult",
          "type": "object"
        }
      },
      "discriminator": {
        "mapping": {
          "CONFIRMED": "#/$defs/ConfirmedResult",
          "HELD": "#/$defs/HeldResult",
          "REJECTED": "#/$defs/RejectedResult",
          "UNKNOWN": "#/$defs/UnknownResult",
          "WAITLISTED": "#/$defs/WaitlistedResult"
        },
        "propertyName": "outcome"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/HeldResult"
        },
        {
          "$ref": "#/$defs/ConfirmedResult"
        },
        {
          "$ref": "#/$defs/WaitlistedResult"
        },
        {
          "$ref": "#/$defs/UnknownResult"
        },
        {
          "$ref": "#/$defs/RejectedResult"
        }
      ]
    },
    "ReconciliationReport": {
      "$defs": {
        "ExternalReference": {
          "additionalProperties": false,
          "properties": {
            "connection_id": {
