            }
          ],
          "title": "Department Key"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "result": {
          "enum": [
            "MATCHED",
            "NO_MATCH",
            "AMBIGUOUS",
            "UNAVAILABLE"
          ],
          "title": "Result",
          "type": "string"
        },
        "candidates": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ExternalReference"
          },
          "title": "Candidates",
          "type": "array"
        },
        "automatic_write_retry": {
          "const": false,
          "default": false,
          "title": "Automatic Write Retry",
          "type": "boolean"
        }
      },
      "required": [
        "attempt_id",
        "connection_id",
        "department_key",
        "observed_at",
        "result"
      ],
      "title": "ReconciliationReport",
      "type": "object"
    }
  }
